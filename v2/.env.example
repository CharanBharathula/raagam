# --- Clerk auth ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Cloudflare Worker backend ---
NEXT_PUBLIC_WORKER_URL=http://127.0.0.1:8787

# --- Meilisearch ---
NEXT_PUBLIC_MEILI_HOST=https://ms-xxxx.meilisearch.io
NEXT_PUBLIC_MEILI_SEARCH_KEY=tenant_search_key

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
YOUTUBE_API_KEY=your_youtube_key_here
LRCLIB_USER_AGENT=Raagam/2.0 (https://raagam.app)

# --- Clerk webhook (/api/clerk/webhook) — get this from the Clerk dashboard
#     when you add the webhook endpoint ---
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# --- Shared secret between Next.js and the Worker for the admin endpoint.
#     Generate with: openssl rand -hex 32 ---
WORKER_ADMIN_SECRET=generate_a_random_hex_string_32_bytes
