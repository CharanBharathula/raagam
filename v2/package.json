{
  "name": "raagam-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Raagam v2 — production-grade Telugu + Bollywood music player",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:db:local": "wrangler d1 execute raagam --local --file=worker/schema.sql --config worker/wrangler.toml",
    "worker:db:remote": "wrangler d1 execute raagam --remote --file=worker/schema.sql --config worker/wrangler.toml",
    "migrate:prepare": "node scripts/migrate-to-d1.mjs",
    "migrate:local": "wrangler d1 execute raagam --local --file=scripts/out/songs.sql --config worker/wrangler.toml",
    "migrate:remote": "wrangler d1 execute raagam --remote --file=scripts/out/songs.sql --config worker/wrangler.toml",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.15.0",
    "@tanstack/react-query": "^5.65.0",
    "@tanstack/react-query-devtools": "^5.65.0",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.5",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "svix": "^1.45.1",
    "serwist": "^9.0.11",
    "@serwist/next": "^9.0.11",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.14",
    "@use-gesture/react": "^10.3.1",
    "@vidstack/react": "^1.12.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "framer-motion": "^11.18.2",
    "gsap": "^3.12.7",
    "hono": "^4.6.18",
    "howler": "^2.2.4",
    "html-to-image": "^1.11.13",
    "lenis": "^1.1.20",
    "lucide-react": "^0.471.2",
    "meilisearch": "^0.46.0",
    "motion": "^11.18.2",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-spring": "^9.7.5",
    "tailwind-merge": "^2.6.0",
    "three": "^0.172.0",
    "wavesurfer.js": "^7.9.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.172.0",
    "@types/wavesurfer.js": "^6.0.12",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2",
    "wrangler": "^3.103.2"
  },
  "engines": {
    "node": ">=20"
  }
}
